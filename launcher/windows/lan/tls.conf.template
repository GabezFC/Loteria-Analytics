# Generated by bootstrap.py for this installation. Do not merge with legacy LAN.
# Match the original path (not just its normalized alias) before proxying it verbatim.
map "$request_method:$request_uri" $cassino_lan_action {
    default deny;
    "~^(GET|HEAD):/api/(health|lotteries|models|draws|probabilities|stats|stats/(inference|combinations|windows)|experiments(/[0-9]+)?|suggestions(/[0-9]+)?|draws/(megasena|lotofacil|quina)/[0-9]+)(\?.*)?\z" read;
    "~^POST:/api/(suggestions|experiments)\z" write;
}

# Regex is case-sensitive; anchors exclude composed and duplicate field values.
map "$http_origin|$http_x_requested_with" $cassino_lan_csrf {
    default 0;
    "~^https://@ORIGIN_PATTERN@\|cassino\z" 1;
}
map "$cassino_lan_action:$cassino_lan_csrf" $cassino_lan_allow {
    default 0;
    "read:0" 1;
    "read:1" 1;
    "write:1" 1;
}

server {
    listen 8443 ssl default_server;
    server_name _;
    server_tokens off;
    ssl_certificate /etc/nginx/cassino-lan/cert.pem;
    ssl_certificate_key /etc/nginx/cassino-lan/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    auth_basic "Cassino LAN";
    auth_basic_user_file /etc/nginx/cassino-lan/htpasswd;
    access_log off;
    root /usr/share/nginx/html;
    index index.html;
    resolver 127.0.0.11 valid=10s ipv6=off;
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-store" always;

    if ($http_host != "@AUTHORITY@") { return 421; }
    # Only origin-form targets. Do not permit an alternative authority in the request line.
    if ($request !~ "^[A-Z]+ /" ) { return 400; }

    location ~* ^/api(?:/|$) {
        if ($cassino_lan_allow = 0) { return 403; }
        set $backend backend:3001;
        proxy_pass http://$backend;
        include /etc/nginx/cassino-proxy.inc;
    }
    location /assets/ {
        if ($request_method !~ "^(GET|HEAD)$") { return 403; }
        try_files $uri =404;
    }
    location / {
        if ($request_method !~ "^(GET|HEAD)$") { return 403; }
        try_files $uri $uri/ /index.html;
    }
}
